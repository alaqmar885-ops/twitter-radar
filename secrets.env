# ============================================================================
# TwitterRadar — API keys & secrets
# ============================================================================
# This file contains LIVE credentials for the alaqmar885-ops GitHub account
# and the You.com MCP integration.  The repo is PRIVATE — do not make it
# public without rotating every key below.
#
# Load with:  set -a; source secrets.env; set +a
#               (or:  export $(grep -v '^#' secrets.env | xargs)
# ============================================================================

# -- GitHub (alaqmar885-ops) -------------------------------------------------
# Scopes: repo, admin:public_key, admin:repo_hook, write:packages, delete:packages
# Missing: read:org (only affects gh org commands)
GH_TOKEN=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

# -- You.com MCP (web-verification enrichment) -------------------------------
# Used by twitter_radar/enrich/youcom.py to web-verify tweet claims.
# Endpoint: https://api.you.com/mcp (streamable-HTTP JSON-RPC)
# Tools: you-search, you-contents, you-balance, you-discover
YDC_API_KEY=ydc-sk-33f7d431bc87c89c-2h4VmmaswawXCnyPbbRwVVhzUWwnO4OO-e1bbdc4a

# -- ProtonVPN (headless IP rotation) ----------------------------------------
# These are NOT API keys.  ProtonVPN uses OpenVPN creds entered interactively:
#   sudo protonvpn init
# and then set the flag below so the manager knows init is done.
PVPN_INIT_DONE=0

# -- twifork (optional keyword search) ---------------------------------------
# Path to a JSON cookie file exported from a throwaway X account.
# Contains ct0 + auth_token.  Leave empty to disable keyword search
# (timeline monitoring via FxTwitter still works without this).
TR_TWIFORK_COOKIES=

# -- Nitter (optional self-hosted fallback) ----------------------------------
# URL of a self-hosted Nitter instance.  Spin one up with:
#   docker compose up -d   (see docker-compose.yml)
# Leave empty to disable the Nitter backend.
TR_NITTER_URL=
