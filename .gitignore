# Note: this repo intentionally tracks EVERYTHING in the workspace, including
# the Python virtualenv (.venv/) and bytecode caches (__pycache__/), at the
# owner's explicit request. To stop tracking them later:
#   git rm -r --cached .venv ; git rm -r --cached */__pycache__ */*/__pycache__
# and restore the ignore rules below.

# Secrets / local config overrides
# (secrets.env itself is tracked deliberately - see AGENTS.md section 10)
.env
.env.*
secrets.json
cookies.json
config.local.yaml

# OS / editor
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/
*.sublime-*
